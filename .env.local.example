# Database PostgreSQL (wajib)
DATABASE_URL=postgres://girlupkilo_app:password@127.0.0.1:5432/girlupkilo

# URL publik aplikasi (dipakai untuk cookie Secure saat HTTPS)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Folder penyimpanan bukti pengeluaran (di luar repo)
UPLOAD_DIR=/var/lib/girlupkilo/uploads

# --- Login dengan Google (opsional) -----------------------------------------
# Buat OAuth 2.0 Client ID (tipe "Web application") di Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
# Wajib HTTPS + domain publik; Google menolak redirect URI berupa IP address.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opsional: batasi email Google yang boleh masuk, pisahkan koma.
# Kosongkan untuk mengizinkan semua domain. Contoh: girlup.id,mail.girlup.id
GOOGLE_ALLOWED_DOMAINS=

# Opsional: "false" = Google hanya untuk login user yang sudah ada
# (tidak ada pendaftaran akun baru otomatis). Default: true
GOOGLE_AUTO_REGISTER=true
